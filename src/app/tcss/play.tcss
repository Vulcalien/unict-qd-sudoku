#play_matrix {
    align: center middle;
    content-align: center middle;
    column-span: 3;
    margin: 0 50;
}

.PlayText {
    width: auto;
    text-align: left;
    margin: 1;
}

#how_to {
    width: 1fr;
    text-align: center;
    height: 15;
}

Play Grid {
    grid-size: 3 2;
    grid-rows: 10% 1fr;
}
